# Copy to .env.local for local development. Set the same values in the
# Vercel project settings for Preview and Production.

# Resend API key used by app/api/contact/route.ts (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend,
# for example "Axiom Wealth Group <website@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Calendly (or other) booking link shown on /contact. Leave empty to render
# the [[CONFIRM]] placeholder card instead.
NEXT_PUBLIC_CALENDLY_URL=
